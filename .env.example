# Copiar a .env. No subir .env al repositorio.

POSTGRES_USER=ecolentes
POSTGRES_PASSWORD=ecolentes
POSTGRES_DB=ecolentes

# Puerto de la máquina por el que se llega a la base. Si ya hay otro PostgreSQL
# escuchando en el 5432 (uno instalado en el sistema, u otro proyecto), se cambia
# acá y en el DATABASE_URL de abajo por uno libre, por ejemplo 5434. Adentro de
# Docker la base se sigue hablando por el 5432, así que esto no la afecta.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecolentes:ecolentes@localhost:5432/ecolentes?schema=public

# Carpeta donde quedan las fotos del DNI y de las recetas. Fuera de la base,
# porque una base con fotos adentro se vuelve impracticable de respaldar, y
# fuera de lo que sirve la web: estas imágenes se piden por la API, que es la
# que sabe quién puede verlas. Hay que respaldarla junto con la base.
UPLOADS_DIR=./uploads

API_PORT=3000
WEB_API_URL=http://localhost:3000

# Puerto de la web mientras se desarrolla (`pnpm dev`). Si está ocupado por otro
# proyecto, el arranque falla y lo avisa, en vez de correrse solo a otro puerto
# y dejarte mirando la aplicación equivocada.
WEB_DEV_PORT=5173

# Puerto donde queda la web cuando todo corre en Docker.
WEB_PORT=8080

# Firma los tokens de sesión. En cada ambiente va una distinta y secreta:
# generar con `openssl rand -base64 48`.
JWT_SECRET=cambiar-esto-en-cada-ambiente
JWT_EXPIRES_IN=8h

# Primer usuario administrador (sólo para el seed). Si no se pone contraseña,
# el seed genera una y la muestra una sola vez.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Administrador
# ADMIN_PASSWORD=
