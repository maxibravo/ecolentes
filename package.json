{
  "name": "ecolentes",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm build:shared && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @ecolentes/shared build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "pnpm --filter @ecolentes/api prisma:generate",
    "db:migrate": "pnpm build:shared && pnpm --filter @ecolentes/api prisma:migrate",
    "db:seed": "pnpm build:shared && pnpm --filter @ecolentes/api prisma:seed",
    "db:seed-demo": "pnpm build:shared && pnpm --filter @ecolentes/api prisma:seed-demo",
    "api:credencial": "pnpm build:shared && pnpm --filter @ecolentes/api service-client",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ]
  }
}
